# TourAPI collection
KOREA_TOUR_API_KEY=

# Shared MySQL database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=tour_recommender
MYSQL_CONNECT_TIMEOUT=10
MYSQL_CHARSET=utf8mb4

# AIHub preprocessing and MySQL loading
AIHUB_DATA_DIRECTORY=data/processed/aihub
AIHUB_LOAD_BATCH_SIZE=5000

# OpenAI embeddings
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenAI structured condition extraction and itinerary selection
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low
OPENAI_EVAL_REASONING_EFFORT=minimal

# RAG token-cost controls. Empty-response retry is disabled by default because
# it resends the complete prompt and can nearly double one execution's cost.
RAG_CONDITION_MAX_OUTPUT_TOKENS=1800
RAG_ITINERARY_MAX_OUTPUT_TOKENS=4500
RAG_LLM_EMPTY_RESPONSE_RETRIES=0
RAG_LLM_RETRY_MAX_OUTPUT_TOKENS=6000
RAG_EVAL_EMPTY_RESPONSE_RETRIES=0
RAG_PROMPT_CANDIDATES_PER_SLOT=3

# LangGraph orchestration and short-term thread memory
LANGGRAPH_MEMORY_ENABLED=true

# LangSmith tracing is opt-in. Inputs/outputs are hidden by default because
# travel requests can contain personal schedules and accommodation details.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=skn28-jeju-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# Optional LLM-as-a-judge model for RAG evaluation
# Calibrate this judge against human labels before using it as a release gate.
OPENAI_EVAL_JUDGE_MODEL=gpt-5-mini

# Road routing (Kakao is used first; Google is the secondary provider)
KAKAO_REST_API_KEY=
KAKAO_MOBILITY_ENABLED=false
GOOGLE_ROUTES_API_KEY=

# Live opening hours, temporary closure, accessibility, and parking facts
GOOGLE_PLACES_API_KEY=

# Version-controlled holiday/special-hours/temporary-closure overrides
RAG_OPERATING_EXCEPTIONS_PATH=data/processed/rag_operating_exceptions.json

# Live integration tests are opt-in because they call paid/external services
RUN_RAG_LIVE_E2E=0
RUN_RAG_FULL_LIVE_E2E=0

# Docker Compose host ports (container MySQL always uses 3306)
DOCKER_MYSQL_PORT=3307
DOCKER_RAG_PORT=8501

# Optional Docker reinitialization controls
RAG_DOCKER_FORCE_MYSQL_INIT=false
RAG_DOCKER_REBUILD_CHROMA=false

# ChromaDB (CHROMA_MODE: persistent or http)
CHROMA_MODE=persistent
CHROMA_PERSIST_DIRECTORY=data/vectorstore
CHROMA_COLLECTION=jeju_places
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_SSL=false
