# Tamna Plan local environment
# Copy this file to .env and fill in secret values. Never commit .env.

# Public data API (only needed when re-crawling TourAPI)
KOREA_TOUR_API_KEY=

# Shared MySQL database
# Set both passwords before the first `docker compose up`.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tour_app
MYSQL_PASSWORD=

ACCOUNT_DB_NAME=accounts_db
TRAVEL_DB_NAME=tour_recommender


# Django account DB + external travel DB
ACCOUNT_DB_NAME=accounts_db
TRAVEL_DB_NAME=tour_recommender

# Optional one-time bootstrap administrator credentials
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=

# AIHub preprocessing/loading (AIHub tables live in MYSQL_DATABASE)
AIHUB_DATA_DIRECTORY=data/processed/aihub
AIHUB_LOAD_BATCH_SIZE=5000
AIHUB_MYSQL_DATABASE=tour_recommender

# OpenAI / RAG
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ChromaDB (Docker: http, embedded local storage: persistent)
CHROMA_MODE=http
CHROMA_PERSIST_DIRECTORY=data/vectorstore
CHROMA_COLLECTION=jeju_places
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_SSL=false

GOOGLE_CLIENT_ID=

KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=