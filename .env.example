# TourAPI collection
KOREA_TOUR_API_KEY=

# Shared MySQL database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=tour_recommender
MYSQL_CONNECT_TIMEOUT=10

# AIHub preprocessing and MySQL loading
AIHUB_DATA_DIRECTORY=data/processed/aihub
AIHUB_LOAD_BATCH_SIZE=5000

# OpenAI embeddings
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenAI structured condition extraction and itinerary selection
OPENAI_CHAT_MODEL=gpt-5-mini

# Road routing (Kakao is used first; Google is the secondary provider)
KAKAO_REST_API_KEY=
KAKAO_MOBILITY_ENABLED=false
GOOGLE_ROUTES_API_KEY=

# Live opening hours, temporary closure, accessibility, and parking facts
GOOGLE_PLACES_API_KEY=

# Version-controlled holiday/special-hours/temporary-closure overrides
RAG_OPERATING_EXCEPTIONS_PATH=data/processed/rag_operating_exceptions.json

# Live integration tests are opt-in because they call paid/external services
RUN_RAG_LIVE_E2E=0

# ChromaDB (CHROMA_MODE: persistent or http)
CHROMA_MODE=persistent
CHROMA_PERSIST_DIRECTORY=data/vectorstore
CHROMA_COLLECTION=jeju_places
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_SSL=false
