# TourAPI collection
KOREA_TOUR_API_KEY=

# Shared MySQL database
# Set both passwords before the first `docker compose up`.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tour_app
MYSQL_PASSWORD=

ACCOUNT_DB_NAME=accounts_db
TRAVEL_DB_NAME=tour_recommender


# AIHub preprocessing and MySQL loading
AIHUB_DATA_DIRECTORY=data/processed/aihub
AIHUB_LOAD_BATCH_SIZE=5000

# OpenAI embeddings
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB (Docker: http, embedded local storage: persistent)
CHROMA_MODE=persistent
CHROMA_PERSIST_DIRECTORY=data/vectorstore
CHROMA_COLLECTION=jeju_places

CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_SSL=false

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenAI structured condition extraction and itinerary selection
OPENAI_CHAT_MODEL=gpt-4o-mini
