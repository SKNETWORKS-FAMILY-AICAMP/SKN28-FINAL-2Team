# TourAPI collection
KOREA_TOUR_API_KEY=

# Django production settings
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURE_PROXY_SSL_HEADER_NAME=HTTP_X_FORWARDED_PROTO
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0

# Shared MySQL database
# Set both passwords before the first `docker compose up`.
MYSQL_ROOT_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_CONNECT_TIMEOUT=10
MYSQL_USER=tour_app
MYSQL_PASSWORD=

ACCOUNT_DB_NAME=accounts_db
TRAVEL_DB_NAME=tour_recommender
MYSQL_DATABASE=tour_recommender


# AIHub preprocessing and MySQL loading
AIHUB_DATA_DIRECTORY=data/processed/aihub
AIHUB_LOAD_BATCH_SIZE=5000

# OpenAI embeddings
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB (Docker: http, embedded local storage: persistent)
CHROMA_MODE=persistent
CHROMA_PERSIST_DIRECTORY=data/vectorstore
CHROMA_COLLECTION=jeju_places

CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_SSL=false

GOOGLE_CLIENT_ID=

KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
KAKAO_JAVASCRIPT_KEY=

# OpenAI structured condition extraction and itinerary selection
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
