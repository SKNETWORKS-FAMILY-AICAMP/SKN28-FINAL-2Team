

# Google 소셜 로그인
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# 프론트엔드(React/Vite) 개발 서버 주소
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 패키지 추천 조회 전용 DB (미지정 시 MYSQL_* 값을 사용)
# 개인 관리자 파일을 쓸 때: MYSQL_LOCAL_ADMIN_ENV=../.mysql-local-admin.env
MYSQL_LOCAL_ADMIN_ENV=
TRAVEL_DB_HOST=127.0.0.1
TRAVEL_DB_PORT=3306
TRAVEL_DB_USER=root
TRAVEL_DB_PASSWORD=
TRAVEL_DB_NAME=tour_recommender
