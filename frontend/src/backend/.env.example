# backend/config/settings.py 가 ROOT_DIR/.env 를 읽습니다.
# 즉, 이 파일을 backend/ 와 같은 레벨(프로젝트 루트)에 ".env" 로 복사해서 사용하세요.

# Google 소셜 로그인 (M001-F-001)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# 프론트엔드(React/Vite) 개발 서버 주소 - CORS 허용 목록 (콤마로 구분)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
